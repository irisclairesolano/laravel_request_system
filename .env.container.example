# Copy this file to .env.container and replace the placeholder values locally.
APP_NAME="Laravel Request System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=laravel_user
DB_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_LOCAL_ROOT_PASSWORD

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
